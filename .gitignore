# Secrets
.env

# Sample policy: the committed .eml files are SAFE, fully synthetic samples
# built by samples/make_samples.py (inert payloads). Never commit real
# malicious samples — keep those zipped, password-protected, and out of git.
samples/*.msg
samples/real_*
samples/*.zip

# Generated output
reports/
!reports/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
pytest-cache-files-*/
.mypy_cache/
venv/
.venv/
env/

# OS / editor
.DS_Store
.idea/
.vscode/
