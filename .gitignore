# Secrets
.env

# Test corpus — never commit real malicious samples to a public repo.
# The generator IS committed (it builds safe synthetic samples); the generated
# .eml files and any real samples are not.
samples/*
!samples/.gitkeep
!samples/make_samples.py

# Generated output
reports/
!reports/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
venv/
.venv/
env/

# OS / editor
.DS_Store
.idea/
.vscode/
