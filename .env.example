# Phishing Email Analyzer — environment template
# Copy to .env and fill in. NEVER commit your real .env.
# Every key is OPTIONAL: with none set, the tool runs fully offline
# (enrichment is skipped, confidence is lower, run still completes).

# --- Threat-intel API keys (enrichment) ---
VT_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_AUTH_KEY=

# --- ThreatLens hand-off (the owner's IOC enrichment platform) ---
# Base URL of a running ThreatLens instance. Leave blank to disable hand-off.
THREATLENS_BASE_URL=
THREATLENS_API_KEY=

# --- Scoring weights (override the defaults in src/config.py) ---
# Uncomment to tune. Values are integers (points added when the signal fires).
# WEIGHT_SPF_FAIL=20
# WEIGHT_DKIM_FAIL=15
# WEIGHT_DMARC_FAIL=20
# WEIGHT_ENVELOPE_MISMATCH=15
# WEIGHT_DISPLAY_NAME_SPOOF=15
# WEIGHT_URL_FLAGGED=25
# WEIGHT_IP_FLAGGED=20
# WEIGHT_ATTACHMENT_KNOWN_BAD=40
# WEIGHT_MACRO_AUTOEXEC=30
# WEIGHT_LOOKALIKE_DOMAIN=15

# --- Network behaviour ---
# HTTP_TIMEOUT=10
